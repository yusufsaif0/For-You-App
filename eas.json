{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "apk": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk", "credentialsSource": "remote" }
    }
  },
  "submit": {
    "production": {}
  }
}
