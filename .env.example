# Set this to your computer's LAN address when testing on a physical device.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Firebase client configuration. These values identify the Firebase project and
# are embedded in the client bundle; never put service-account credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID

# Use your HTTPS Railway API URL in production, with the /api suffix.
# EXPO_PUBLIC_API_URL=https://your-api.up.railway.app/api
